# Copy to .env for docker compose. Never commit real values.

# AWS (containers mount ~/.aws read-only and use your SSO session)
AWS_PROFILE=your-sso-profile
AWS_REGION=us-east-1

# Bedrock
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_KB_ID=
BEDROCK_KB_DATA_SOURCE_ID=
BEDROCK_KB_S3_BUCKET=

# Langfuse (use Langfuse Cloud keys, or a local instance)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Where containers reach Langfuse. host.docker.internal = your host machine.
LANGFUSE_DOCKER_BASE_URL=http://host.docker.internal:3000

# Ecommerce API admin credential (seeded on first boot)
API_USERNAME=admin
API_PASSWORD=admin123

# Web session encryption secret
SESSION_SECRET=change-me
